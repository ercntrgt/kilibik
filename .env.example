# --- Sunucu ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/kilibik
REDIS_URL=redis://127.0.0.1:6379
# En az 32 karakter. Üretimde gizli tutulur.
JWT_SECRET=change-me-change-me-change-me-change-me
# Telefon numaralarını DB'de düz yazmamak için HMAC anahtarı (>= 32 karakter)
PHONE_HASH_SECRET=change-me-too-change-me-too-change-me-too

# OTP sağlayıcısı: log (konsola yazar) | test (sabit kod: 000000)
OTP_PROVIDER=log

# Push sağlayıcısı: log | apns | fcm | both
PUSH_PROVIDER=log
# APNs (token tabanlı kimlik doğrulama)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY_P8=
APNS_PRODUCTION=false
# FCM HTTP v1
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Konum blob'u Redis TTL (saniye). Kırmızı çizgi: kalıcı konum yok.
LOCATION_TTL_SECONDS=300
# İstek saklama süresi (gün)
REQUEST_RETENTION_DAYS=90
# Silinen hesapların kesin temizlenme süresi (gün)
ACCOUNT_PURGE_DAYS=30
