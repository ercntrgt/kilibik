{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "../shared/src/*"
      ]
    },
    "types": [
      "react-native"
    ]
  },
  "include": [
    "src",
    "App.tsx",
    "index.js",
    "../shared/src"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios"
  ]
}
